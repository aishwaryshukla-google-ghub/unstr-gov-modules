project_id = "nyl-pr-dbx-data-dev-01"
region     = "us-east4"
location   = "us"

data_products = {
  "unstructured-patent-product" = {
    location     = "us"
    display_name = "UNSTRUCTURED-PATENT-DATA-PRODUCT"
    description  = "Curated data product containing unstructured patent data marts and object tables."
    labels = {
      client    = "nyl"
      stream    = "ws2"
      lifecycle = "dev"
    }
    owner_emails = [
      "aishwaryshukla@google.com"
    ]
    # In client environments without permission to create new Google Groups:
    # Option A: Reference existing corporate AD/Okta synced Google Group emails
    # Option B: Omit access_groups / leave empty {} to publish catalog metadata
    access_groups = {
      "patent-readers" = {
        display_name = "Patent Data Readers"
        description  = "Read-only access for unstructured data consumers"
        google_group = "nyl-data-consumers@example.com"
      }
    }
  }
}

data_product_assets = {
  "unstructured-patent-product" = {
    "obj-tbl-pdf-asset" = {
      resource = "//bigquery.googleapis.com/projects/nyl-pr-dbx-data-dev-01/datasets/bq_omni_test_dtst/tables/ext_tbl_omni_unstructured_metadata"
      access_group_configs = [
        {
          access_group = "patent-readers"
          iam_roles    = ["roles/bigquery.dataViewer"]
        }
      ]
    }
  }
}
